#: src/extra/graphapp/clipboard.cpp:79
msgid "Unable to open the clipboard"
msgstr "Neįmanoma atidaryti iškarpinės"

#: src/gnuwin32/console.cpp:2122
msgid "Insufficient memory. Please close the console"
msgstr "Nepakanka atminties. Uždarykite konsolę"

#: src/gnuwin32/console.cpp:2177 src/gnuwin32/console.cpp:2231
#: src/gnuwin32/preferences.cpp:351
#, c-format
msgid ""
"Font %s-%d-%d  not found.\n"
"Using system fixed font"
msgstr ""
"Šriftas %s-%d-%d nerastas.\n"
"Fiksuoto sistemos šrifto naudojimas"

#: src/gnuwin32/console.cpp:2334
msgid "Save selection to"
msgstr "Įrašyti pasirinkimą į"

#: src/gnuwin32/console.cpp:2336
msgid "Save console contents to"
msgstr "Įrašyti konsolės turinį į"

#: src/gnuwin32/console.cpp:2443
msgid "Scrolling.\n"
msgstr "Slinkimas.\n"

#: src/gnuwin32/console.cpp:2444
msgid "  Keyboard: PgUp, PgDown, Ctrl+Arrows, Ctrl+Home, Ctrl+End,\n"
msgstr "  Klaviatūra: PgUp, PgDown, Ctrl+rodyklės, Ctrl+Home, Ctrl+End,\n"

#: src/gnuwin32/console.cpp:2445
msgid ""
"  Mouse: use the scrollbar(s).\n"
"\n"
msgstr ""
"  Pelė: naudokite slinkties juostą (-as).\n"
"\n"

#: src/gnuwin32/console.cpp:2446
msgid "Editing.\n"
msgstr "Redagavimas.\n"

#: src/gnuwin32/console.cpp:2447
msgid "  Moving the cursor: \n"
msgstr "  Žymeklio perkėlimas: \n"

#: src/gnuwin32/console.cpp:2448
msgid "     Left arrow or Ctrl+B: move backward one character;\n"
msgstr "     Rodyklė kairėn arba Ctrl+B: judėti atgal per vieną simbolį;\n"

#: src/gnuwin32/console.cpp:2449
msgid "     Right arrow or Ctrl+F: move forward one character;\n"
msgstr "     Rodyklė dešinėn arba Ctrl+F: judėti į priekį per vieną simbolį;\n"

#: src/gnuwin32/console.cpp:2450
msgid "     Home or Ctrl+A: go to beginning of line;\n"
msgstr "     Home arba Ctrl+A: eiti į eilutės pradžią;\n"

#: src/gnuwin32/console.cpp:2451
msgid "     End or Ctrl+E: go to end of line;\n"
msgstr "     End arba Ctrl+E: eiti į eilutės pabaigą;\n"

#: src/gnuwin32/console.cpp:2452
msgid "  History: Up and Down Arrows, Ctrl+P, Ctrl+N\n"
msgstr "  Istorija: rodyklės aukštyn ir žemyn, Ctrl+P, Ctrl+N\n"

#: src/gnuwin32/console.cpp:2453
msgid "  Deleting:\n"
msgstr "  Šalinimas:\n"

#: src/gnuwin32/console.cpp:2454
msgid "     Del or Ctrl+D: delete current character or selection;\n"
msgstr "     Del arba Ctrl+D: naikinti dabartinį simbolį arba pasirinkimą;\n"

#: src/gnuwin32/console.cpp:2455
msgid "     Backspace: delete preceding character;\n"
msgstr "     Backspace: ištrinti ankstesnį simbolį;\n"

#: src/gnuwin32/console.cpp:2456
msgid "     Ctrl+Del or Ctrl+K: delete text from current character to end of line.\n"
msgstr "     Ctrl+Del arba Ctrl+K: šalinti tekstą nuo dabartinio simbolio iki eilutės pabaigos.\n"

#: src/gnuwin32/console.cpp:2457
msgid "     Ctrl+U: delete all text from current line.\n"
msgstr "     Ctrl+U: ištrinti visą tekstą iš dabartinės eilutės.\n"

#: src/gnuwin32/console.cpp:2458
msgid "  Copy and paste.\n"
msgstr "  Kopijuoti ir įklijuoti.\n"

#: src/gnuwin32/console.cpp:2459
msgid "     Use the mouse (with the left button held down) to mark (select) text.\n"
msgstr "     Norėdami pažymėti tekstą naudokite pelę (laikyti kairįjį mygtuką).\n"

#: src/gnuwin32/console.cpp:2460
msgid "     Use Shift+Del (or Ctrl+C) to copy the marked text to the clipboard and\n"
msgstr "     Naudoti Shift+Del (arba Ctrl+C) nukipijuoti pažymėtą tekstą į iškarpinę ir\n"

#: src/gnuwin32/console.cpp:2461
msgid "     Shift+Ins (or Ctrl+V or Ctrl+Y) to paste the content of the clipboard (if any)  \n"
msgstr "     Shift+Ins (arba Ctrl+V arba Ctrl+Y) įklijuoti iškarpinės turinį (jei yra)  \n"

#: src/gnuwin32/console.cpp:2462
msgid "     to the console, Ctrl+X first copy then paste\n"
msgstr "     į konsolę, Ctrl+X pirmiausia nukopijuokite tada įklijuokite\n"

#: src/gnuwin32/console.cpp:2463
msgid "  Misc:\n"
msgstr "  Kita:\n"

#: src/gnuwin32/console.cpp:2464
msgid "     Ctrl+L: Clear the console.\n"
msgstr "     Ctrl+L: išvalyti konsolę.\n"

#: src/gnuwin32/console.cpp:2465
msgid "     Ctrl+O or INS: Toggle overwrite mode: initially off.\n"
msgstr "     Ctrl+O arba INS: perjungti perrašymo režimą: iš pradžių išjungta.\n"

#: src/gnuwin32/console.cpp:2466
msgid "     Ctrl+T: Interchange current char with one to the left.\n"
msgstr "     Ctrl+T: apsikeisti dabartinį simbolį su vienu į kairę.\n"

#: src/gnuwin32/console.cpp:2467
msgid ""
"\n"
"Note: Console is updated only when some input is required.\n"
msgstr ""
"\n"
"Pastaba: konsolė atnaujinama tik tada, kai reikia įvesties.\n"

#: src/gnuwin32/console.cpp:2468
msgid ""
"  Use Ctrl+W to toggle this feature off/on.\n"
"\n"
msgstr ""
"  Naudokite Ctrl+W, kad perjungtumėte šios funkcijos būseną.\n"
"\n"

#: src/gnuwin32/console.cpp:2469
msgid ""
"Use ESC to stop the interpreter.\n"
"\n"
msgstr ""
"Norėdami sustabdyti interpretatorių, naudokite ESC.\n"
"\n"

#: src/gnuwin32/console.cpp:2470
msgid ""
"TAB starts completion of the current word.\n"
"\n"
msgstr ""
"TAB pradeda užbaigti dabartinį žodį.\n"
"\n"

#: src/gnuwin32/console.cpp:2471
msgid "Standard Windows hotkeys can be used to switch to the\n"
msgstr "Standartiniai Windows spartieji klavišai gali būti naudojami norint perjungti\n"

#: src/gnuwin32/console.cpp:2472
msgid "graphics device (Ctrl+Tab or Ctrl+F6 in MDI, Alt+Tab in SDI)"
msgstr "grafikos įrenginys (Ctrl+Tab arba Ctrl+F6 (MDI), Alt+Tab (SDI))"

