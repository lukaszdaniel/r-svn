#: src/gnuwin32/editor.cpp:719
msgid "R EDITOR\n"
msgstr "EDYTOR R\n"

#: src/gnuwin32/editor.cpp:721
msgid "A standard text editor for editing and running R code.\n"
msgstr "Standardowy edytor tekstu do edytowania i uruchamiania kodu języka R.\n"

#: src/gnuwin32/editor.cpp:723
msgid "RUNNING COMMANDS\n"
msgstr "URUCHAMIANIE POLECEŃ\n"

#: src/gnuwin32/editor.cpp:724
msgid "To run a line or section of R code, select the code and either\n"
msgstr "Aby uruchomić wiersz lub sekcję kodu R, zaznacz kod i albo:\n"

#: src/gnuwin32/editor.cpp:725
msgid "     Press Ctrl-R\n"
msgstr "     Naciśnij Ctrl-R\n"

#: src/gnuwin32/editor.cpp:726
msgid "     Select \"Run line or selection\" from the \"Edit\" menu\n"
msgstr "     Wybierz \"Uruchom wiersz lub zaznaczenie\" z menu \"Edycja\"\n"

#: src/gnuwin32/editor.cpp:727
msgid "     Press the \"Run line or selection\" icon on the toolbar\n"
msgstr "     Naciśnij ikonę \"Uruchom wiersz lub zaznaczenie\" na pasku narzędzi\n"

#: src/gnuwin32/editor.cpp:728
msgid "This will copy the selected commands to the console and evaluate them.\n"
msgstr "To skopiuje zaznaczone polecenia do konsoli oraz przeliczy je.\n"

#: src/gnuwin32/editor.cpp:729
msgid "If there is no selection, this will just run the current line and advance\n"
msgstr "Jeśli nie ma zaznaczenia, to uruchomi bieżącą linię i przesunie\n"

#: src/gnuwin32/editor.cpp:730
msgid "the cursor by one line.\n"
msgstr "kursor o jedną linię.\n"

#: src/gnuwin32/editor.cpp:742 src/gnuwin32/editor.cpp:821
