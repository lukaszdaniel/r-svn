#: src/gnuwin32/console.cpp:2446
msgid "Editing.\n"
msgstr "Edition.\n"

#: src/gnuwin32/console.cpp:2447
msgid "  Moving the cursor: \n"
msgstr "  Déplacement du curseur : \n"

#: src/gnuwin32/console.cpp:2448
msgid "     Left arrow or Ctrl+B: move backward one character;\n"
msgstr "     Flčche gauche ou Ctrl+B : se déplacer d'un caractčre vers la gauche ;\n"

#: src/gnuwin32/console.cpp:2449
msgid "     Right arrow or Ctrl+F: move forward one character;\n"
msgstr "     Flčche droite ou Ctrl+F : se déplacer d'un caractčre vers la droite ;\n"

#: src/gnuwin32/console.cpp:2450
msgid "     Home or Ctrl+A: go to beginning of line;\n"
msgstr "     Début ou Ctrl+A : aller au début de la ligne ;\n"

#: src/gnuwin32/console.cpp:2451
msgid "     End or Ctrl+E: go to end of line;\n"
msgstr "     Fin ou Ctrl+E : aller ŕ la fin de la ligne ;\n"

#: src/gnuwin32/console.cpp:2452
msgid "  History: Up and Down Arrows, Ctrl+P, Ctrl+N\n"
msgstr "  Historique : flčches haut et bas, Ctrl+P, Ctrl+N\n"

#: src/gnuwin32/console.cpp:2453
msgid "  Deleting:\n"
msgstr "  Effacement :\n"

#: src/gnuwin32/console.cpp:2454
msgid "     Del or Ctrl+D: delete current character or selection;\n"
msgstr "     Del ou Ctrl+D : effacer le caractčre courant ou la sélection ;\n"

#: src/gnuwin32/console.cpp:2455
msgid "     Backspace: delete preceding character;\n"
msgstr "     Suppr. arričre : effacer le caractčre précédent ;\n"

#: src/gnuwin32/console.cpp:2456
msgid "     Ctrl+Del or Ctrl+K: delete text from current character to end of line.\n"
msgstr "     Ctrl+Suppr ou Ctrl+K : effacer le texte du caractčre sous le curseur jusqu'ŕ la fin.\n"

#: src/gnuwin32/console.cpp:2457
msgid "     Ctrl+U: delete all text from current line.\n"
msgstr "     Ctrl+U : effacer tout le texte de la ligne courante.\n"

#: src/gnuwin32/console.cpp:2458
msgid "  Copy and paste.\n"
msgstr "  Copier et coller.\n"

#: src/gnuwin32/console.cpp:2459
msgid "     Use the mouse (with the left button held down) to mark (select) text.\n"
msgstr "     Utilisez la souris (bouton gauche enfoncé) pour marquer (sélectionner) le texte.\n"

#: src/gnuwin32/console.cpp:2460
msgid "     Use Shift+Del (or Ctrl+C) to copy the marked text to the clipboard and\n"
msgstr "     Utilisez Shift+Suppr (ou Ctrl+C) pour copier le texte marqué dans le presse-papier et\n"

#: src/gnuwin32/console.cpp:2461
msgid "     Shift+Ins (or Ctrl+V or Ctrl+Y) to paste the content of the clipboard (if any)  \n"
msgstr "     Shift+Ins (ou Ctrl+V ou Ctrl+Y) pour coller le contenu du presse-papier  \n"

#: src/gnuwin32/console.cpp:2462
msgid "     to the console, Ctrl+X first copy then paste\n"
msgstr "     dans la console, Ctrl+X copie et colle en une fois\n"

#: src/gnuwin32/console.cpp:2463
msgid "  Misc:\n"
msgstr "  Divers :\n"

#: src/gnuwin32/console.cpp:2464
msgid "     Ctrl+L: Clear the console.\n"
msgstr "     Ctrl+L : Effacer la console.\n"

#: src/gnuwin32/console.cpp:2465
msgid "     Ctrl+O or INS: Toggle overwrite mode: initially off.\n"
msgstr "     Ctrl+O ou INS : Bascule le mode surimpression ; désactivé au départ.\n"

#: src/gnuwin32/console.cpp:2466
msgid "     Ctrl+T: Interchange current char with one to the left.\n"
msgstr "     Ctrl+T : Echange le caractčre courant avec le précédent.\n"

#: src/gnuwin32/console.cpp:2467
msgid ""
"\n"
"Note: Console is updated only when some input is required.\n"
msgstr ""
"\n"
"Note : la console est mise ŕ jour uniquement lorsqu'une entrée est requise.\n"

#: src/gnuwin32/console.cpp:2468
msgid ""
"  Use Ctrl+W to toggle this feature off/on.\n"
"\n"
msgstr ""
"  Utilisez Ctrl+W pour (dés)activer ce comportement.\n"
"\n"

#: src/gnuwin32/console.cpp:2469
msgid ""
"Use ESC to stop the interpreter.\n"
"\n"
msgstr ""
"Utilisez ECHAPPE pour arręter le calcul.\n"
"\n"

#: src/gnuwin32/console.cpp:2470
msgid ""
"TAB starts completion of the current word.\n"
"\n"
msgstr ""
"TAB pour compléter le mot courant.\n"
"\n"

#: src/gnuwin32/console.cpp:2471
msgid "Standard Windows hotkeys can be used to switch to the\n"
msgstr "Les raccourcis Windows standard sont utilisables pour activer\n"

#: src/gnuwin32/console.cpp:2472
msgid "graphics device (Ctrl+Tab or Ctrl+F6 in MDI, Alt+Tab in SDI)"
msgstr "les périphériques graphiques (Ctrl+Tab ou Ctrl+F6 en MDI, Alt+Tab en SDI)"

