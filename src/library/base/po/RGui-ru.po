msgid "Not enough memory"
msgstr "Недостаточно памяти"

msgid "Insufficient memory: text not copied to the clipboard"
msgstr "Недостаточно памяти: текст не скопирован в буфер обмена"

msgid "Unable to open the clipboard"
msgstr "Не могу открыть буфер обмена"

msgid "Insufficient memory. Please close the console"
msgstr "Недостаточно памяти. Пожалуйста, закройте консоль"

#, c-format
msgid ""
"Font %s-%d-%d  not found.\n"
"Using system fixed font"
msgstr ""
"Шрифт %s-%d-%d  не найден.\n"
"Используется системный шрифт"

msgid "Save selection to"
msgstr "Сохранить выделение в"

msgid "Save console contents to"
msgstr "Сохранить содержимое консоли в"

msgid "Scrolling.\n"
msgstr "Прокрутка.\n"

msgid "  Keyboard: PgUp, PgDown, Ctrl+Arrows, Ctrl+Home, Ctrl+End,\n"
msgstr "  Клавиатура: PgUp, PgDown, Ctrl+Arrows, Ctrl+Home, Ctrl+End,\n"

msgid ""
"  Mouse: use the scrollbar(s).\n"
"\n"
msgstr ""
"  Мышь: использовать полос(ы) прокрутки.\n"
"\n"

msgid "Editing.\n"
msgstr "Редактирование.\n"

msgid "  Moving the cursor: \n"
msgstr "  Перемещение курсора: \n"

msgid "     Left arrow or Ctrl+B: move backward one character;\n"
msgstr "     Левая стрелка или Ctrl+B: назад на один символ;\n"

msgid "     Right arrow or Ctrl+F: move forward one character;\n"
msgstr "     Стрелка вправо или Ctrl+F: вперед на один символ;\n"

msgid "     Home or Ctrl+A: go to beginning of line;\n"
msgstr "     Home или Ctrl+A: к началу строки;\n"

msgid "     End or Ctrl+E: go to end of line;\n"
msgstr "     End или Ctrl+E: в конец строки;\n"

msgid "  History: Up and Down Arrows, Ctrl+P, Ctrl+N\n"
msgstr "  История: стрелки вверх и вниз, Ctrl+P, Ctrl+N\n"

msgid "  Deleting:\n"
msgstr "  Удаление:\n"

msgid "     Del or Ctrl+D: delete current character or selection;\n"
msgstr "     Del или Ctrl+D: удалить текущий символ или выделение;\n"

msgid "     Backspace: delete preceding character;\n"
msgstr "     Backspace: удалить предыдущий символ;\n"

msgid "     Ctrl+Del or Ctrl+K: delete text from current character to end of line.\n"
msgstr "     Ctrl+Del или Ctrl+K: удалить текст от текущего символа до конца строки.\n"

msgid "     Ctrl+U: delete all text from current line.\n"
msgstr "     Ctrl+U: удалить весь текст текущей строки.\n"

msgid "  Copy and paste.\n"
msgstr "  Копирование и вставка:\n"

msgid "     Use the mouse (with the left button held down) to mark (select) text.\n"
msgstr "     Использовать мышь (с нажатой левой кнопкой) для выделения текста.\n"

msgid "     Use Shift+Del (or Ctrl+C) to copy the marked text to the clipboard and\n"
msgstr "     Использовать Shift+Del (или Ctrl+C) для копирования выделения в буфер\n"

msgid "     Shift+Ins (or Ctrl+V or Ctrl+Y) to paste the content of the clipboard (if any)  \n"
msgstr "     Shift+Ins (или Ctrl+V или Ctrl+Y) для вставки содержимого буфера (если есть)  \n"

msgid "     to the console, Ctrl+X first copy then paste\n"
msgstr "     на консоль, Ctrl+X сначала копирует, потом вставляет.\n"

msgid "  Misc:\n"
msgstr "  Разное:\n"

msgid "     Ctrl+L: Clear the console.\n"
msgstr "     Ctrl+L: Очистить консоль.\n"

msgid "     Ctrl+O or INS: Toggle overwrite mode: initially off.\n"
msgstr "     Ctrl+O: Переключить замену/вставку символов: вначале отключена.\n"

msgid "     Ctrl+T: Interchange current char with one to the left.\n"
msgstr "     Ctrl+T: Поменять текущий символ с предыдущим.\n"

msgid ""
"\n"
"Note: Console is updated only when some input is required.\n"
msgstr ""
"\n"
"Внимание: Консоль обновляется только когда нужен ввод.\n"

msgid ""
"  Use Ctrl+W to toggle this feature off/on.\n"
"\n"
msgstr ""
"  Используйте Ctrl+W для включения/выключения этого свойства.\n"
"\n"

msgid ""
"Use ESC to stop the interpreter.\n"
"\n"
msgstr ""
"Используйте Esc для остановки интерпретатора.\n"
"\n"

msgid ""
"TAB starts completion of the current word.\n"
"\n"
msgstr ""
"TAB осуществляет дополнение текущего слова.\n"
"\n"

msgid "Standard Windows hotkeys can be used to switch to the\n"
msgstr "Стандартные клавиши Windows можно использовать для перехода к\n"

msgid "graphics device (Ctrl+Tab or Ctrl+F6 in MDI, Alt+Tab in SDI)"
msgstr "окну графики (Ctrl+Tab или Ctrl+F6 в MDI, Alt+Tab в SDI)"

