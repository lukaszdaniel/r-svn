msgid "To run a line or section of R code, select the code and either\n"
msgstr "For å køyra ei linje eller eit utval R-kode, merk koden, og anten\n"

msgid "     Press Ctrl-R\n"
msgstr "     trykk «Ctrl + R»,\n"

