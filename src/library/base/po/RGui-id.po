msgid "Not enough memory"
msgstr "Tidak cukup memory"

msgid "Insufficient memory: text not copied to the clipboard"
msgstr "Tidak cukup memory: teks tidak dapat disalin ke clipboard"

msgid "Unable to open the clipboard"
msgstr "Tidak dapat membuka clipboard"

msgid "Insufficient memory. Please close the console"
msgstr "Tidak cukup memori. Tutup console"

#, c-format
msgid ""
"Font %s-%d-%d  not found.\n"
"Using system fixed font"
msgstr ""
"Font %s-%d-%d  tidak ditemukan.\n"
"Menggunakan font tetap sistem"

msgid "Save selection to"
msgstr "Simpan pilihan ke"

msgid "Save console contents to"
msgstr "Simpan konten konsol ke"

msgid "Scrolling.\n"
msgstr "Gulung\n"

msgid "  Keyboard: PgUp, PgDown, Ctrl+Arrows, Ctrl+Home, Ctrl+End,\n"
msgstr "  Keyboard: PgUp, PgDown, Ctrl+Arrows, Ctrl+Home, Ctrl+End,\n"

msgid ""
"  Mouse: use the scrollbar(s).\n"
"\n"
msgstr ""
"  Mouse: gunakan bilah gulir.\n"
"\n"

msgid "Editing.\n"
msgstr "Mengedit.\n"

msgid "  Moving the cursor: \n"
msgstr "  Memindahkan kursor: \n"

msgid "     Left arrow or Ctrl+B: move backward one character;\n"
msgstr "     Panah kiri atau Ctrl+B: mundur satu karakter;\n"

msgid "     Right arrow or Ctrl+F: move forward one character;\n"
msgstr "     Panah kanan atau Ctrl+F: maju satu karakter;\n"

msgid "     Home or Ctrl+A: go to beginning of line;\n"
msgstr "     Home atau Ctrl+A: go to beginning of line;\n"

msgid "     End or Ctrl+E: go to end of line;\n"
msgstr "     End atau Ctrl+E: pindah ke akhir baris;\n"

msgid "  History: Up and Down Arrows, Ctrl+P, Ctrl+N\n"
msgstr "  Riwayat: Panah Atas dan Bawah, Ctrl+P, Ctrl+N\n"

msgid "  Deleting:\n"
msgstr "  Menghapus:\n"

msgid "     Del or Ctrl+D: delete current character or selection;\n"
msgstr "     Del atau Ctrl+D: hapus karakter atau pilihan;\n"

msgid "     Backspace: delete preceding character;\n"
msgstr "     Backspace: hapus karakter sebelumnya;\n"

msgid "     Ctrl+Del or Ctrl+K: delete text from current character to end of line.\n"
msgstr "     Ctrl+Del atau Ctrl+K: hapus teks dari karakter saat ini ke akhir baris.\n"

msgid "     Ctrl+U: delete all text from current line.\n"
msgstr "     Ctrl+U: hapus semua teks dari baris saat ini.\n"

msgid "  Copy and paste.\n"
msgstr "  Salin dan tempel.\n"

msgid "     Use the mouse (with the left button held down) to mark (select) text.\n"
msgstr "     Gunakan mouse (dengan tombol kiri ditahan) untuk menandai (memilih) teks.\n"

msgid "     Use Shift+Del (or Ctrl+C) to copy the marked text to the clipboard and\n"
msgstr "     Gunakan Shift+Del (atau Ctrl+C) untuk menyalin teks yang ditandai ke clipboard dan\n"

msgid "     Shift+Ins (or Ctrl+V or Ctrl+Y) to paste the content of the clipboard (if any)  \n"
msgstr "     Shift+Ins (atau Ctrl+V atau Ctrl+Y) untuk menempelkan konten clipboard (jika ada)  \n"

msgid "     to the console, Ctrl+X first copy then paste\n"
msgstr "     ke konsol, Ctrl+X salin terlebih dahulu lalu tempel\n"

msgid "  Misc:\n"
msgstr "  Misc:\n"

msgid "     Ctrl+L: Clear the console.\n"
msgstr "     Ctrl+L: Bersihkan konsol.\n"

msgid "     Ctrl+O or INS: Toggle overwrite mode: initially off.\n"
msgstr "     Ctrl+O atau INS: Alihkan mode timpa: awalnya nonaktif.\n"

msgid "     Ctrl+T: Interchange current char with one to the left.\n"
msgstr "     Ctrl+T: Tukar karakter saat ini dengan satu di sebelah kiri.\n"

msgid ""
"\n"
"Note: Console is updated only when some input is required.\n"
msgstr ""
"\n"
"Catatan: Konsol hanya diperbarui jika beberapa input diperlukan.\n"

msgid ""
"  Use Ctrl+W to toggle this feature off/on.\n"
"\n"
msgstr ""
"  Gunakan Ctrl+W untuk menonaktifkan/mengaktifkan fitur ini.\n"
"\n"

msgid ""
"Use ESC to stop the interpreter.\n"
"\n"
msgstr ""
"Gunakan ESC untuk menghentikan penerjemah.\n"
"\n"

msgid ""
"TAB starts completion of the current word.\n"
"\n"
msgstr ""
"TAB memulai penyelesaian kata saat ini.\n"
"\n"

msgid "Standard Windows hotkeys can be used to switch to the\n"
msgstr "Tombol pintas Windows standar dapat digunakan untuk beralih ke tombol\n"

msgid "graphics device (Ctrl+Tab or Ctrl+F6 in MDI, Alt+Tab in SDI)"
msgstr "perangkat grafis (Ctrl+Tab atau Ctrl+F6 di MDI, Alt+Tab di SDI)"

