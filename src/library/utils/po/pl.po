msgstr "argument 'x' musi być w kodowaniu UTF-8 (wliczając ASCII)"

msgid "'charClass' is not available on this platform"
msgstr "'charClass' nie jest obsługiwany na tej platformie"

msgid "input must be a character string"
msgstr "wejście musi być ciągiem znaków"

#, c-format
msgid "'%s' must be a character vector of length 1"
msgstr "argument '%s' musi być wektorem tekstowym o długości 1"

#, c-format
msgid "nsl() was unable to resolve host '%s'"
msgstr "'nsl()' nie był w stanie nawiązać połączenia z hostem '%s'"

msgid "unknown format returned by 'gethostbyname'"
msgstr "nieznany format zwrócony przez 'gethostbyname()'"

msgid "nsl() is not supported on this platform"
msgstr "'nsl()' nie jest obsługiwany na tej platformie"

msgid "unable to start data editor"
msgstr "nie można uruchomić edytora danych"

msgid "invalid progressbar -- has it been closed?"
msgstr "nieprawidłowy pasek postępu -- czy został zamknięty?"

msgid "unknown type"
msgstr "nieznany typ"

msgid "menu functions can only be used in the GUI"
msgstr "funkcje menu mogą być używane jedynie w GUI"

#, c-format
msgid "unable to retrieve items for %s (%s)"
msgstr "nie można pobrać pozycji dla %s (%s)"

#, c-format
msgid "unable to add menu (%s)"
msgstr "nie można dodać menu (%s)"

#, c-format
msgid "unable to add menu item (%s)"
msgstr "nie można dodać pozycji menu (%s)"

msgid "menu does not exist"
msgstr "menu nie istnieje"

#, c-format
msgid "unable to delete menu item (%s)"
msgstr "nie można usunąć pozycji menu (%s)"

#, c-format
msgid "invalid '%s' value"
msgstr "niepoprawna wartość '%s'"

#, c-format
msgid "unhandled key type %s\n"
msgstr "nieobsługiwany typ klucza %s\n"

#, c-format
msgid "unhandled key type %lu\n"
msgstr "nieobsługiwany typ klucza %lu\n"

#, c-format
msgid "RegQueryInfoKey error code %d: '%s'"
msgstr "kod błędu %d RegQueryInfoKey: '%s'"

#, c-format
msgid "Registry key '%ls' not found"
msgstr "Nie znaleziono klucza rejestru '%ls'"

#, c-format
msgid "RegOpenKeyEx error code %d: '%s'"
msgstr "kod błędu %d RegOpenKeyEx: '%s'"

msgid "unsupported version of Windows"
msgstr "niewspierana wersja systemu Windows"

msgid "'raw = FALSE' and format is a not a known text format"
msgstr "'raw = FALSE' a podany format nie jest znanym formatem tekstowym"

msgid "argument must be a character vector or a raw vector"
msgstr "argument 'text' musi być wektorem tekstowym lub pustym wektorem"

msgid "unable to open the clipboard"
msgstr "nie można otworzyć schowka"

msgid "unable to write to the clipboard"
msgstr "nie można zapisać do schowka"

msgid "'title' must be a character string"
msgstr "argument 'title' musi być ciągiem znaków"

msgid "'text' must be a character string"
msgstr "argument 'text' musi być ciągiem znaków"

#, c-format
msgid "'%s' must be length 1"
msgstr "argument '%s' musi mieć długość równą 1"

#, c-format
msgid "'%s' must be a list"
msgstr "argument '%s' musi być listą"

#, c-format
msgid "'%s' element %d is not a window handle"
msgstr "element %2$d '%1$s' nie jest uchwytem okna"

msgid "Select one or more"
msgstr "Wybierz jeden lub więcej"

msgid "Select one"
msgstr "Wybierz jeden"

msgid "'default' must be a character string"
msgstr "argument 'default' musi być ciągiem znaków"

msgid "'default' is overlong"
msgstr "argument 'default' jest zbyt długi"

msgid "'caption' must be a character string"
msgstr "argument 'caption' musi być ciągiem znaków"

msgid "'filterindex' must be an integer value"
msgstr "argument 'filterindex' musi być wartością całkowitą"

#~ msgid "'multi' must be a logical value"
#~ msgstr "argument 'multi' musi być wartością logiczną"
