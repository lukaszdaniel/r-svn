msgid "wrong argument count"
msgstr "niepoprawna liczba argumentów"

msgid "hash table type must be a scalar string"
msgstr "typ tablicy mieszającej musi być tekstem"

#, c-format
msgid "hash table type '%s' is not supported"
msgstr "typ '%s' tablicy mieszającej nie jest wspierany"

msgid "bad hash table type"
msgstr "zły typ tablicy mieszającej"

#, c-format
msgid "invalid '%s' argument"
msgstr "niepoprawny argument '%s'"

msgid "invalid quote symbol set"
msgstr "niepoprawnie ustawiony symbol cudzysłowu"

msgid "cannot open the connection"
msgstr "nie można otworzyć połączenia"

msgid "cannot read from this connection"
msgstr "nie można czytać z tego połączenia"

#, c-format
msgid "quoted string on line %d terminated by EOF"
msgstr "cytowany ciąg znaków w linii %d przerwany przez znak końca pliku (EOF)"

msgid "the first argument must be of mode character"
msgstr "pierwszy argument musi być trybu tekstowego"

#, c-format
msgid "invalid 'numerals' string: \"%s\""
msgstr "niepoprawny ciąg znaków 'numerals': \"%s\""

msgid "Selection: "
msgstr "Wybór: "

